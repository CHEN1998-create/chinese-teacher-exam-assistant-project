# 复制为 backend.env 后填写真实值；backend.env 不得提交仓库。
# 密钥生成：openssl rand -hex 32

# 数据库连接：复用服务器上已有的 kaobian-postgres 容器（compose 已挂 kaobian-net 网络，
# 主机直接填容器名）。账号/密码/库名与服务器实际一致。
DATABASE_URL="postgresql://kaobian:替换为服务器PG密码@kaobian-postgres:5432/kaobian"
# 若 PostgreSQL 为宿主机直装（非容器）：compose 需给 migrate/backend 加
# extra_hosts: host.docker.internal:host-gateway，主机改为 host.docker.internal。

# 服务监听：容器内默认 3000，由 Docker 内网访问，不需要改
PORT=3000

# 位于 Next.js 反代之后（TLS 终止于 Caddy）
TRUST_PROXY=true

# 允许跨域来源（纵深防御；浏览器实际同源）：演示用 http://服务器公网IP，生产用 https://备案域名
CORS_ORIGINS="http://47.101.32.47"

# 内部反代密钥：与 frontend.env 的 INTERNAL_TOKEN、deploy/internal-token.txt 保持一致
INTERNAL_TOKEN="替换为强随机值"

# 受邀模式：只认真实会话 cookie；必须与前端 NEXT_PUBLIC_AUTH_MODE=invited 一致
AUTH_MODE=invited

# 首个管理员账号初始化引导令牌：调用管理账号初始化接口时携带，初始化完成后撤销/更换
ADMIN_BOOTSTRAP_TOKEN="替换为强随机值"
