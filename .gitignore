# 本仓库只管理项目级文档与 QA 验收脚本；frontend/ 与 backend/ 各自独立成库
/*
!/.gitignore
!/docs
!/.qa-harness

# deploy/ 只入库编排/反代配置、env 样例与部署手册；密钥与真实 env 永不入库
!/deploy
/deploy/*
!/deploy/docker-compose.yml
!/deploy/Caddyfile
!/deploy/backend.env.example
!/deploy/frontend.env.example
!/deploy/README.md

# QA 运行产物与依赖不入库
.qa-harness/node_modules/
.qa-harness/shots/
.qa-harness/test-results/
.qa-harness/playwright-report/
.qa-harness/.auth/
