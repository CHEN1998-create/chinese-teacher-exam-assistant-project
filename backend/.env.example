# 复制为 .env 后按环境填写；.env 不得提交仓库。
# 本文件只放占位符，请勿写入任何真实密钥。

# 数据库连接（本地开发可通过 SSH 隧道：ssh -L 5432:127.0.0.1:5432 <用户>@<服务器IP>）
DATABASE_URL="postgresql://kaobian:CHANGE_ME@localhost:5432/kaobian"

# 服务监听端口；容器内默认 3000
PORT=3000

# 监听地址：
# - 容器/Docker 网络部署保持默认 0.0.0.0（由安全组与网络隔离保证不可公网直连）；
# - Nginx 与本服务同机裸进程部署时设为 127.0.0.1，后端端口不对公网暴露。
# HOST=127.0.0.1

# 位于 Nginx 等反向代理之后时设为 true，以信任 X-Forwarded-*（TLS 终止于代理）
# TRUST_PROXY=true

# 允许跨域的前端来源，逗号分隔；受邀环境填备案产品域名
CORS_ORIGINS="http://localhost:3000"

# 内部反代密钥：Next.js 服务端代理经 x-internal-token 头携带。
# 本地开发不设置时守卫放行；受邀/正式环境必须设置强随机值（例如 openssl rand -hex 32）。
# INTERNAL_TOKEN=

# 运行模式：demo（默认，信任反代注入的演示身份头）/ invited（只认真实会话 cookie）。
# 受邀环境必须设为 invited，并与前端 NEXT_PUBLIC_AUTH_MODE 保持一致。
# AUTH_MODE=demo

# 首个管理员账号引导令牌：调用管理账号初始化接口时携带，初始化完成后撤销/更换。
# ADMIN_BOOTSTRAP_TOKEN=
